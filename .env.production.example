# ============================================================================
# PRODUCTION ENVIRONMENT — copy to .env.production and fill in real values.
#
# Every variable below is actually read by apps/backend/src/config/env.ts.
# Anything the app does not read has been removed: the previous template
# advertised SMTP_*, STRIPE_*, MAX_LOGIN_ATTEMPTS, feature flags and an API
# docs path that no code path has ever consulted.
#
# The API refuses to start in production if any variable marked REQUIRED is
# missing or left at a development default — see validateConfig().
# ============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---- Database (REQUIRED) ---------------------------------------------------
# Either DATABASE_URL, or the discrete DB_* set below — both are understood.
DATABASE_URL=postgresql://user:password@your-timescale-host.com:5432/flight_tracker
# DB_HOST=your-timescale-host.com
# DB_PORT=5432
# DB_NAME=flight_tracker
# DB_USER=postgres
# DB_PASSWORD=

# TLS to the database. Defaults to on in production; set false only for a
# database reachable over a private network (e.g. the compose stack).
DB_SSL=true
DB_POOL_MAX=10

# ---- Redis (REQUIRED) ------------------------------------------------------
# The price-check queue and the rate limiter both need this. Use rediss:// for
# TLS providers such as Upstash.
REDIS_URL=rediss://default:password@your-redis-host.upstash.io:6379
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- Authentication (REQUIRED) ---------------------------------------------
# Generate each independently: `openssl rand -base64 48`
# Must be at least 32 characters, and the two must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Price provider --------------------------------------------------------
# 'duffel' in production. 'mock' serves generated fares and spends nothing —
# useful for a staging environment that shouldn't touch the budget.
PRICE_PROVIDER=duffel

# ---- Duffel (REQUIRED) -----------------------------------------------------
# https://app.duffel.com — price checks cannot run without this.
DUFFEL_API_KEY=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_MS=30000

# ---- CORS (REQUIRED) -------------------------------------------------------
# Comma-separated. Must not contain localhost or * in production.
CORS_ORIGIN=https://app.flighttracker.com

# ---- Push notifications ----------------------------------------------------
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=
PUSH_RECEIPT_DELAY_MS=60000

# ---- Email (fallback channel + password reset) -----------------------------
# Without these, password reset emails cannot be delivered.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flighttracker.app

# ---- Scheduler -------------------------------------------------------------
# Leave false on API instances: the scheduler belongs in the worker process
# (`npm run worker`), and running it on every replica would have them race.
RUN_SCHEDULER_IN_PROCESS=false
# How often the worker wakes to find trackers that are *due*. Each tracker is
# checked on its own interval, tiered by how close departure is — a flat
# interval across all trackers is what made the old 5-minute default cost
# ~8,600 searches per route per month.
PRICE_TICK_INTERVAL_MS=900000
MAX_CONCURRENT_PRICE_FETCHES=5
# How long an identical route search is reused, so N users tracking the same
# route cost one billed Duffel call rather than N. Sized to the tightest
# polling tier.
QUOTE_CACHE_TTL_SEC=3600
SEARCH_CACHE_TTL_SEC=1800

# ---- Search budget (cost ceiling) ------------------------------------------
# Duffel charges $0.005 per search beyond a 1500:1 search-to-book ratio. With
# no bookings in v1 every search is billable, so this is a hard monthly cap.
# 2300 searches ~= $11.50 ~= INR 1000/month.
SEARCH_BUDGET_MONTHLY=2300
# Share reserved for the scheduler; the rest is available to in-app flight
# search and live tracker prices.
SEARCH_BUDGET_SCHEDULER_SHARE=0.65
SEARCH_BUDGET_WARN_THRESHOLD=0.8
SEARCH_COST_USD=0.005

# ---- Alerting --------------------------------------------------------------
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=1000
# Minimum gap between two alerts for the same tracker (default 1 hour).
ALERT_COOLDOWN_MS=3600000

# ---- Rate limits -----------------------------------------------------------
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10
API_RATE_WINDOW_MS=60000
API_RATE_MAX=100
QUOTE_RATE_WINDOW_MS=60000
QUOTE_RATE_MAX=20

# ---- App / logging ---------------------------------------------------------
APP_NAME=Flight Tracker
# Deep-link scheme used in password reset emails; must match app.json's scheme.
APP_SCHEME=flighttracker
LOG_LEVEL=info
