# Local development. Copy to apps/backend/.env — `docker compose up -d` brings
# up Postgres and Redis at these addresses.
# See .env.production.example for the full production variable set.

NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=debug

# Database / Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flight_tracker
REDIS_URL=redis://localhost:6379
DB_SSL=false

# Auth — placeholder values are fine locally; production refuses to boot with them.
JWT_SECRET=dev-secret-key
JWT_REFRESH_SECRET=dev-refresh-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Price provider: 'mock' or 'duffel'. Defaults to mock outside production so
# day-to-day development never spends billable Duffel searches. The mock serves
# a large generated fare catalogue whose prices drift over time, so alerts can
# be exercised end to end offline.
PRICE_PROVIDER=mock
# Lower this to make mock prices move faster while testing a price drop.
MOCK_PRICE_BUCKET_MS=900000

# Duffel — use a test-mode key (duffel_test_...). Only needed when
# PRICE_PROVIDER=duffel.
DUFFEL_API_KEY=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2

# Push notifications (optional locally — a simulator can't receive push anyway)
EXPO_ACCESS_TOKEN=

# Email fallback + password reset (optional locally)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@watchmyfares.com

# CORS — Expo dev server origins
CORS_ORIGIN=http://localhost:19000,http://localhost:8081

# Scheduler: true runs price checks inside the API process, which is what you
# want for a single-command local stack.
RUN_SCHEDULER_IN_PROCESS=true
# How often the worker wakes to look for trackers that are *due*. Each tracker
# is then checked on its own tier interval (see PRICE_TIERS in the README),
# not on this one.
PRICE_TICK_INTERVAL_MS=900000
MAX_CONCURRENT_PRICE_FETCHES=5
QUOTE_CACHE_TTL_SEC=3600
SEARCH_CACHE_TTL_SEC=1800

# Monthly search ceiling. Duffel bills $0.005 per excess search and this app
# takes no bookings, so this is a hard cost cap, not a guideline.
SEARCH_BUDGET_MONTHLY=2300
SEARCH_BUDGET_SCHEDULER_SHARE=0.65

# Alerting
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=1000
ALERT_COOLDOWN_MS=3600000
